# Server-only. Never add NEXT_PUBLIC_ to these names.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Required for AI generation on Vercel / NODE_ENV=production.
# Use an Upstash Redis database's REST credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional tuning; hard upper bounds are enforced in code.
AI_TIMEOUT_MS=20000
DAILY_GENERATION_LIMIT=200
