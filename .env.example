# Server-only. Never add NEXT_PUBLIC_ to these names.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# For NVIDIA, put your NVIDIA key in OPENAI_API_KEY above and use:
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_MODEL=deepseek-ai/deepseek-v4.1-flash
# AI_TIMEOUT_MS=45000
# Optional tuning; hard upper bounds are enforced in code.
AI_TIMEOUT_MS=20000
# Best-effort per-server-instance limit; resets with the instance.
DAILY_GENERATION_LIMIT=200
